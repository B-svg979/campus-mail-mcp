# Run: campus-mail init --mode demo (generates your actual .env and a random token)
CAMPUS_MODE=demo
CAMPUS_TOKEN=replace-with-a-random-token-at-least-32-characters
CAMPUS_DATA_DIR=./data
CAMPUS_HOST=127.0.0.1
CAMPUS_PORT=8765
# Add the externally used host, with port if necessary. No scheme or path.
CAMPUS_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
# Optional browser clients; ordinary server-to-server school calls need no Origin.
CAMPUS_ALLOWED_ORIGINS=
CAMPUS_TIMEZONE=Asia/Shanghai
CAMPUS_SYNC_SECONDS=900
CAMPUS_LOOKBACK_DAYS=30
CAMPUS_MAX_MESSAGES=200
CAMPUS_TIMEOUT_SECONDS=20
CAMPUS_MAX_MESSAGE_BYTES=10485760
CAMPUS_MAX_ATTACHMENT_BYTES=5242880
CAMPUS_MAX_BODY_CHARS=200000
CAMPUS_EML_DIR=./mail-import

# Credentials belong only to the collector, not MCP tool arguments.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ADDRESS=
# Conventional Exchange endpoint; school's availability must be tested.
MAIL_EWS_URL=https://mail.xjtlu.edu.cn/EWS/Exchange.asmx
MAIL_EWS_AUTH=NTLM
MAIL_IMAP_HOST=mail.xjtlu.edu.cn
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=ssl
# School adapter uses environment to honor the platform's existing HTTP CONNECT proxy.
# Local standalone installs retain direct. NO_PROXY is respected in environment mode.
MAIL_IMAP_PROXY_MODE=direct
MAIL_IMAP_FOLDER=INBOX
# password or xoauth2. For xoauth2, provide an access token; automatic OAuth login
# and token refresh are NOT included in this version.
MAIL_IMAP_AUTH=password
MAIL_IMAP_ACCESS_TOKEN=
